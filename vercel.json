{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sw.js|manifest.webmanifest|icon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feature/private-notes-glass": false,
      "feature/diary-independent-inner-life": false,
      "feature/dual-automation-api": false,
      "fix/qq-memory-context-continuity": false
    }
  }
}
